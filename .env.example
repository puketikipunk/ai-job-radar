# Copy to .env for local use. Do not commit real values.
CAREERPILOT_CONFIG_PATH=config/profile.yaml
CAREERPILOT_SMTP_HOST=smtp.office365.com
CAREERPILOT_SMTP_PORT=587
CAREERPILOT_SMTP_USERNAME=
CAREERPILOT_SMTP_PASSWORD=
CAREERPILOT_EMAIL_FROM=
CAREERPILOT_EMAIL_TO=

# Optional inbox ingestion for official job-alert emails (Outlook / Microsoft 365).
CAREERPILOT_IMAP_HOST=outlook.office365.com
CAREERPILOT_IMAP_PORT=993
CAREERPILOT_IMAP_USERNAME=
CAREERPILOT_IMAP_PASSWORD=
